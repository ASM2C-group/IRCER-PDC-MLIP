@SET BASISDIR  /gpfslocalsup/spack_soft/cp2k/6.1/intel-19.0.4-2che3reso4wbexi7dfjaaqfmtyzu3l7q/share/data
&GLOBAL
  PROJECT SiCN 
  PRINT_LEVEL LOW
  RUN_TYPE ENERGY_FORCE
  WALLTIME 09:45:00 
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
    

  &PRINT
   &STRESS_TENSOR ON
     FILENAME stress.dat
    &END
    &FORCES ON
      FILENAME force.dat
    &END
  &END



  &DFT
      BASIS_SET_FILE_NAME  ${BASISDIR}/GTH_BASIS_SETS
      POTENTIAL_FILE_NAME  ${BASISDIR}/GTH_POTENTIALS
    &MGRID
      CUTOFF 1000
      REL_CUTOFF 50
    &END MGRID
    &QS
      WF_INTERPOLATION PS
      EXTRAPOLATION_ORDER 3
      METHOD GPW
    &END QS
    &SCF
      &DIAGONALIZATION OFF
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      !CHOLESKY INVERSE
      SCF_GUESS RESTART 
      
      EPS_SCF 1.0E-6
      &OT ON
        MINIMIZER CG
        LINESEARCH 3PNT
        PRECONDITIONER FULL_SINGLE_INVERSE
        ENERGY_GAP 0.01
      &END OT
      MAX_SCF 80
      &OUTER_SCF
        MAX_SCF 80
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL
       &PBE
       &END PBE
      &END XC_FUNCTIONAL
      &vdW_POTENTIAL
       DISPERSION_FUNCTIONAL PAIR_POTENTIAL
       &PAIR_POTENTIAL
        TYPE DFTD3
        PARAMETER_FILE_NAME dftd3.dat
        REFERENCE_FUNCTIONAL PBE
#        CALCULATE_C9_TERM TRUE
       &END PAIR_POTENTIAL
      &END vdW_POTENTIAL
    &END XC

    &PRINT
    &END PRINT
  &END DFT

  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0 
      ALPHA_BETA_GAMMA 90.0000 90.0000 90.0000
      PERIODIC XYZ
    &END CELL    
    &TOPOLOGY
      COORDINATE XYZ
      COORD_FILE_NAME ./init_run.xyz
    &END TOPOLOGY

    &PRINT
      &ATOMIC_COORDINATES ON
      &END
    &END

    &KIND Si
      BASIS_SET DZVP-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END
    &KIND C
      BASIS_SET DZVP-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END
    &KIND N
      BASIS_SET DZVP-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END
    &KIND H
      BASIS_SET DZVP-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END
  &END SUBSYS
&END FORCE_EVAL

