units           metal
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data data.FPMD

pair_style      mliap unified IRCER-SiCNH-MACE_v1.0.model-mliap_lammps.pt 0
pair_coeff      * * Si H C N

neighbor        3 bin
neigh_modify    delay 10

timestep        0.0005

thermo          10
thermo_style    custom  step time cpu temp press pe ke etotal

restart         10000 SiCN.restart

dump            myDump all xyz 1000 dump.xyz

fix             1 all nvt temp 300 300 0.1

run             100000 upto

